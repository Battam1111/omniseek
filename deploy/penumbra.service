# systemd unit for a non-Docker, always-on Penumbra (Linux). Install:
#   sudo cp deploy/penumbra.service /etc/systemd/system/
#   # edit User=, WorkingDirectory=, ExecStart= venv path, and PENUMBRA_CONTACT_EMAIL below
#   sudo systemctl daemon-reload && sudo systemctl enable --now penumbra
# Logs:  journalctl -u penumbra -f
[Unit]
Description=Penumbra - self-hosted deep-retrieval MCP
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=penumbra
WorkingDirectory=/opt/penumbra
ExecStart=/opt/penumbra/.venv/bin/python -m penumbra.serve_http
Restart=on-failure
RestartSec=5

# Loopback-only by default. To reach it off-box, front it with a reverse proxy + firewall and set
# PENUMBRA_HTTP_HOST deliberately (Penumbra warns when it binds a non-loopback address).
Environment=PENUMBRA_HTTP_HOST=127.0.0.1
Environment=PENUMBRA_HTTP_PORT=8765
# Environment=PENUMBRA_CONTACT_EMAIL=you@example.org   # polite-pool fast lane (recommended)

# Hardening: Penumbra only needs to write its own state dir + inbox.
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=%h/.penumbra %h/penumbra-inbox

[Install]
WantedBy=multi-user.target
