# Bytes as-is: never normalize line endings (the tree is shipped verbatim to a mac via
# git archive | tar).
* -text

# Shell scripts must stay LF so they run on a fresh Unix clone (a stray CRLF breaks the shebang).
*.sh text eol=lf

# Historical one-off debug scripts stay in git but out of deploys.
scripts/debug/ export-ignore
